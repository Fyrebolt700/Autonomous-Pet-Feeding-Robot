{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor MotorLeft = motor(PORT6, true);\nmotor MotorRight = motor(PORT1, false);\noptical Optical3 = optical(PORT3);\nmotor MotorDoor = motor(PORT5, false);\nmotor MotorBumper = motor(PORT2, false);\ntouchled TouchLED4 = touchled(PORT4);\nbumper Bumper7 = bumper(PORT7);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n#include \"iq_cpp.h\"\nusing namespace vex;\n\nconst int STANDARD_SPEED = 30;\nconst double START_ENCODER = 0;\nconst int HUE_TOLERANCE = 15;\nconst int BUMPER_ANGLE = 90;\n\nconst int NUM_BOWLS = 2;\nconst int BOWL1_HUE = 220;\nconst int BOWL2_HUE = 310;\n\nvoid configureAllSensors(){\n  BrainInertial.calibrate();\n  wait(2,seconds);\n  BrainInertial.setHeading(0,degrees);\n  BrainInertial.setRotation(0,degrees);\n  MotorLeft.setPosition(0,turns);\n  MotorRight.setPosition(0,turns);\n  Brain.Screen.clearScreen();\n  Brain.Screen.setFont(mono15);\n} \n\nvoid releaseFood(double time)\n{\n  if (time > 0)\n  {\n    MotorDoor.spinToPosition(-90,degrees);\n    wait(time, seconds);\n    MotorDoor.spinToPosition(0,degrees);\n  }\n}\n\ndouble detectColor()\n{\n  int hue_detected = Optical3.hue();\n  if ((abs(hue_detected - BOWL1_HUE) <= HUE_TOLERANCE))\n  {\n    return 0.5;\n  } \n  else if ((abs(hue_detected - BOWL2_HUE) <= HUE_TOLERANCE))\n  {\n    return 2.5;\n  }\n  else\n  {\n    return 0;\n  }\n}\n\nvoid moveUntilBumper()\n{\n  MotorLeft.spin(forward, STANDARD_SPEED, percent);\n  MotorRight.spin(forward, STANDARD_SPEED, percent);\n\n  while (!Bumper7.pressing()){}\n\n  MotorLeft.stop();\n  MotorRight.stop();\n}\n\nvoid afterDetection()\n{\n  \n  color color_prev = Optical3.color();\n  double current_pos = MotorLeft.position(degrees);\n  double target_pos = current_pos - 50;\n\n  MotorLeft.spinToPosition(target_pos,degrees,false);\n  MotorRight.spinToPosition(target_pos, degrees,false);\n  \n  MotorBumper.spinToPosition(-100,degrees, false);\n\n  MotorLeft.spin(forward, STANDARD_SPEED, percent);\n  MotorRight.spin(forward, STANDARD_SPEED, percent);\n\n  while (Optical3.color() == color_prev){ }\n  wait(2, seconds);\n  MotorBumper.spinToPosition(BUMPER_ANGLE,degrees);\n}\n\n\nvoid moveHome()\n{\n  double move_home = START_ENCODER;\n  MotorBumper.spinToPosition(-BUMPER_ANGLE, degrees, false);\n  MotorLeft.spinToPosition(move_home, degrees,false);\n  MotorRight.spinToPosition(move_home, degrees);\n}\n\nvoid startRoutine() \n{\n  Brain.Screen.print(\"Ready To Start\");\n  while(!TouchLED4.pressing()){}\n  Brain.Screen.clearScreen();\n\n  MotorBumper.spinToPosition(100, degrees, false);\n  Optical3.setLight(ledState::on);\n\n  bool loop_running = true;\n  int bowls_found = 0;\n  while (bowls_found < NUM_BOWLS && loop_running)\n  {\n    moveUntilBumper();\n    double food_release_time = detectColor();\n    if (food_release_time > 0 && loop_running)\n    {\n      bowls_found++;\n      releaseFood(food_release_time);\n\n      if (bowls_found < NUM_BOWLS && loop_running)\n      {\n        afterDetection();\n  \n      } else if (bowls_found >= NUM_BOWLS && loop_running)\n      {\n        loop_running = false;\n      }\n    } else \n    {\n      afterDetection();\n    }\n  }\n  moveHome();\n}\n\nint main() \n{\n  vexcodeInit();\n  configureAllSensors();\n  startRoutine();\n  Brain.programStop();\n}","textLanguage":"cpp","robotConfig":[{"port":[6],"name":"MotorLeft","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[1],"name":"MotorRight","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[3],"name":"Optical3","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{},"triportSourcePort":22},{"port":[5],"name":"MotorDoor","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[2],"name":"MotorBumper","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[4],"name":"TouchLED4","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[7],"name":"Bumper7","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.62.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}